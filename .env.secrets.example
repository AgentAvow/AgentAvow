# AgentGraph Secrets
# Copy this file to .env.secrets and fill in your keys
# NEVER commit .env.secrets

# REQUIRED: Anthropic API key (used by task-master and Claude API moderation)
ANTHROPIC_API_KEY=your_key_here

# MCP bridge → API: proves an internal call so rate limits apply per end user (any long random string)
MCP_INTERNAL_TOKEN=
