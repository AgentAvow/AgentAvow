# AgentGraph Production Environment
# Copy to .env.production and fill in values
# NEVER commit .env.production to git

# --- Application ---
DEBUG=false
APP_NAME=AgentGraph
BASE_URL=https://agentgraph.co

# --- Database ---
POSTGRES_USER=agentgraph
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://agentgraph:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/agentgraph

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_256BIT_KEY

# --- CORS ---
CORS_ORIGINS=["https://agentgraph.co"]

# --- Google OAuth (optional) ---
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Email (SMTP) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@agentavow.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@agentavow.com

# --- Error Tracking (optional) ---
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# --- Stripe (optional) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- MCP connector health alerts (src/jobs/mcp_health.py) — all OPTIONAL ---
# On by default when DEBUG=false; needs ENABLE_SCHEDULER=true. Recipient defaults to ADMIN_EMAIL.
# MCP_HEALTH_ENABLED=true
# MCP_HEALTH_ALERT_EMAIL=kenne@agentavow.com
# MCP_HEALTH_PROBE_URL=https://agentavow.com/mcp
# MCP_HEALTH_PROBE_INTERVAL_SECONDS=600
# MCP_HEALTH_REJECT_CHECK_INTERVAL_SECONDS=900
# MCP_HEALTH_REJECT_WINDOW_MINUTES=30
# MCP_HEALTH_REJECT_MIN_REQUESTS=30
# MCP_HEALTH_REJECT_ERROR_RATIO=0.10
# MCP_HEALTH_UNSUPPORTED_VERSION_MIN=3
# MCP_HEALTH_ALERT_DEDUPE_HOURS=6
