{
  "_doc": "Behavioral-tier eval corpus. 'known_good' = widely used, maintained MCP servers shipped as packages; a behavioral finding on one of these is a false positive until a human says otherwise. 'fixtures' = synthetic servers in tests/fixtures/behavioral shipped INTO the sandbox via --files-b64 (nothing malicious is ever published); each has the exact findings the graders must and must not raise. Run scripts/sandbox/eval/run_eval.py. A known_good entry may carry expect_rules: findings with those rules are correct, not false positives (e.g. a server that ships third-party telemetry). 'skill_fixtures' = fixture SKILLS under tests/fixtures/behavioral/skills/<dir> run through scripts/sandbox/skill_exercise.sh (locally: hooks + scripts run against a temp mount with the network stubbed out, 'simulated_egress' standing in for the sandbox's capture; --sandbox ships the tree as a tar.gz). 'known_good_skills' = real public skill repos ({repo: owner/repo}) for the skill plan; a finding on one is a false positive until a human says otherwise.",
  "known_good": [
    {
      "surface": "npm",
      "name": "@modelcontextprotocol/server-filesystem"
    },
    {
      "surface": "npm",
      "name": "@modelcontextprotocol/server-memory"
    },
    {
      "surface": "npm",
      "name": "@modelcontextprotocol/server-sequential-thinking"
    },
    {
      "surface": "npm",
      "name": "@modelcontextprotocol/server-everything",
      "expect_rules": [
        "behavioral_undeclared_egress"
      ],
      "note": "demo server; a tool fetches raw.githubusercontent.com \u2014 true undeclared egress"
    },
    {
      "surface": "npm",
      "name": "@playwright/mcp"
    },
    {
      "surface": "npm",
      "name": "@upstash/context7-mcp"
    },
    {
      "surface": "npm",
      "name": "@notionhq/notion-mcp-server"
    },
    {
      "surface": "npm",
      "name": "@supabase/mcp-server-supabase"
    },
    {
      "surface": "npm",
      "name": "firecrawl-mcp"
    },
    {
      "surface": "npm",
      "name": "tavily-mcp"
    },
    {
      "surface": "npm",
      "name": "exa-mcp-server",
      "expect_rules": [
        "behavioral_undeclared_egress"
      ],
      "note": "ships third-party telemetry to api.agnost.ai \u2014 a TRUE undeclared-egress finding"
    },
    {
      "surface": "npm",
      "name": "@brave/brave-search-mcp-server"
    },
    {
      "surface": "npm",
      "name": "mcp-remote"
    },
    {
      "surface": "pypi",
      "name": "mcp-server-fetch",
      "expect_rules": ["ssrf_internal_fetch"],
      "_note": "TRUE positive, not an FP: the official fetch server follows a caller-supplied URL to the link-local sentinel with no target-IP validation (the CVE-2026-14540 / JPMorgan SSRF class). Confirmed live 2026-10-06; it connected to 169.254.254.254."
    },
    {
      "surface": "pypi",
      "name": "mcp-server-git"
    },
    {
      "surface": "pypi",
      "name": "mcp-server-time"
    },
    {
      "surface": "pypi",
      "name": "mcp-server-sqlite"
    },
    {
      "surface": "pypi",
      "name": "markitdown-mcp"
    },
    {
      "surface": "npm",
      "name": "@wonderwhy-er/desktop-commander",
      "expect_rules": [
        "behavioral_undeclared_egress"
      ],
      "note": "install-time telemetry to telemetry.desktopcommander.app + a download from storage.googleapis.com \u2014 true undeclared egress; also exceeds the memory cap (exit 137)"
    },
    {
      "surface": "npm",
      "name": "@modelcontextprotocol/server-puppeteer",
      "expect_rules": [
        "behavioral_undeclared_egress"
      ],
      "note": "postinstall downloads Chromium from storage.googleapis.com \u2014 true undeclared install-time egress (and the 512 MB cap kills it: exit 137)"
    }
  ],
  "fixtures": [
    {
      "file": "benign_server.py",
      "label": "benign",
      "must_not_raise": [
        "annotation_readonly_violated",
        "credential_canary_exfiltrated",
        "canary_echoed_in_result",
        "behavioral_undeclared_egress"
      ],
      "expect": {
        "launch_ok": true,
        "min_calls": 2
      }
    },
    {
      "file": "lies_readonly_server.py",
      "label": "lies_about_readonly",
      "must_raise": [
        "annotation_readonly_violated"
      ],
      "must_not_raise": [
        "credential_canary_exfiltrated"
      ],
      "expect": {
        "launch_ok": true
      }
    },
    {
      "file": "canary_echo_server.py",
      "label": "echoes_secret",
      "env_names": [
        "GITHUB_TOKEN"
      ],
      "must_raise": [
        "canary_echoed_in_result"
      ],
      "expect": {
        "launch_ok": true
      }
    },
    {
      "file": "slow_server.py",
      "label": "hangs_on_call",
      "must_not_raise": [
        "annotation_readonly_violated"
      ],
      "expect": {
        "launch_ok": true,
        "call_errors_include": [
          "call_timeout"
        ]
      }
    },
    {
      "file": "crash_on_call_server.py",
      "label": "crashes",
      "must_raise": [
        "tool_call_crashed_server"
      ],
      "expect": {
        "launch_ok": true
      }
    },
    {
      "file": "never_initializes_server.py",
      "label": "never_initializes",
      "must_not_raise": [
        "annotation_readonly_violated",
        "credential_canary_exfiltrated"
      ],
      "expect": {
        "launch_ok": false
      }
    },
    {
      "file": "ssrf_follows_server.py",
      "label": "ssrf_follows_caller_url",
      "must_not_raise": [
        "credential_canary_exfiltrated"
      ],
      "must_raise_sandbox": [
        "ssrf_internal_fetch"
      ],
      "expect": {
        "launch_ok": true,
        "min_calls": 1
      }
    },
    {
      "file": "ssrf_guarded_server.py",
      "label": "ssrf_validates_target",
      "must_not_raise": [
        "ssrf_internal_fetch",
        "credential_canary_exfiltrated"
      ],
      "must_not_raise_sandbox": [
        "ssrf_internal_fetch"
      ],
      "expect": {
        "launch_ok": true,
        "min_calls": 1
      }
    }
  ],
