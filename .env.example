# ============================================================
# AgentAvow — Environment Configuration
# Copy this file to .env and fill in the values.
#
# Every setting in src/config.py is listed here (tests/test_settings.py checks it).
# Settings are type-checked at startup: a bad value stops the service with an error
# that names the variable (never its value). In production (ENVIRONMENT=production,
# or DEBUG=false with ENVIRONMENT unset) the service also refuses to start with the
# default JWT_SECRET or with DATABASE_URL / REDIS_URL on localhost.
# Secrets (keys, tokens, passwords) go in .env.secrets, never in this file.
# ============================================================

# --- Application ---
APP_NAME=AgentAvow
DEBUG=false                          # Set true for development
# local | staging | production. Empty: production when DEBUG=false, else local.
ENVIRONMENT=
# json | text. Empty: text when DEBUG=true, else json (one JSON object per line).
# Both formats carry request_id / trace_id and redact secrets and emails (src/observability).
# LOG_FORMAT=

# --- Database (REQUIRED) ---
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/agentgraph
POSTGRES_PASSWORD=YOUR_PASSWORD      # Used by docker-compose

# --- Redis (REQUIRED) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication (REQUIRED for production) ---
JWT_SECRET=CHANGE-ME-TO-A-RANDOM-64-CHAR-STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15   # Short-lived access tokens
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# --- Rate Limiting (OPTIONAL) ---
RATE_LIMIT_READS_PER_MINUTE=100
RATE_LIMIT_WRITES_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=5

# --- Everything else (OPTIONAL; the defaults are shown) ---
# See the comments in src/config.py for what each one does. Empty secrets
# (keys, tokens, passwords) belong in .env.secrets.
