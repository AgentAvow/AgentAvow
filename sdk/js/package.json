{
  "name": "agentavow-trust",
  "version": "0.2.1",
  "description": "Client-side verification of AgentAvow Trust Score v2 signed envelopes (JCS-canonical, Ed25519-over-SHA-256). Peer of the Python agentavow-sdk verify module. Formerly agentgraph-trust.",
  "type": "module",
  "license": "MIT",
  "author": "AgentAvow",
  "homepage": "https://agentavow.com",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./verify": "./src/verify.js",
    "./client": "./src/client.js",
    "./vercel-ai": {
      "types": "./dist/vercel-ai.d.ts",
      "default": "./dist/vercel-ai.js"
    }
  },
  "files": [
    "index.js",
    "src/",
    "README.md",
    "bin/",
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "canonicalize": "2.1.0"
  },
  "keywords": [
    "agentavow",
    "agentgraph",
    "trust-score",
    "ed25519",
    "jcs",
    "rfc8785",
    "jws",
    "did",
    "verifiable",
    "vercel-ai-sdk",
    "tool-gate",
    "mcp"
  ],
  "bin": {
    "agentavow-trust": "bin/cli.js"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
